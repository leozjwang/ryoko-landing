---
const icons: Record<string, string> = {
  map:'<path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3V6Z"/><path d="M9 3v15M15 6v15"/>',
  nearby:'<path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/>',
  translate:'<path d="M3 3h14v12H8l-5 4V3Z"/><path d="m8 11 3-5 3 5M9 9h4M17 8h4v13l-4-4h-5"/>',
  me:'<circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/>',
};
---
<div class="app-preview" id="app-preview">
  <div class="app-frame" id="app-frame" data-period="midday">
    <div class="app-status"><time id="device-clock">9:41</time><span class="app-island"></span><span aria-hidden="true">▰</span></div>
    <button class="app-close" id="close-app" aria-label="Close expanded preview" hidden>×</button>
    <section class="app-pane map-pane" id="app-map" role="tabpanel" aria-labelledby="tab-map">
      <div id="live-map" aria-label="Interactive map. Drag to pan, use plus and minus to zoom." tabindex="0"></div>
      <form class="map-search glass" id="map-search" role="search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><input id="place-search" aria-label="Search places" placeholder="Search places" maxlength="150" autocomplete="off"/><button type="submit" aria-label="Search">↵</button></form>
      <div class="map-tools"><button class="round-control glass" id="locate-me" aria-label="Follow my location" title="Follow my location" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 3-7 18-3-8-8-3 18-7Z"/></svg></button><button class="round-control glass" id="toggle-layers" aria-expanded="false" aria-controls="map-layers" aria-label="Map layers"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 10 5-10 5L2 8l10-5ZM2 12l10 5 10-5M2 16l10 5 10-5"/></svg></button><button class="round-control glass" id="zoom-in" aria-label="Zoom in">+</button><button class="round-control glass" id="zoom-out" aria-label="Zoom out">−</button></div>
      <div class="map-layers glass" id="map-layers" hidden><strong>Show on map</strong><label><input type="checkbox" value="food" checked/>Food & drink</label><label><input type="checkbox" value="washroom" checked/>Washrooms</label><label><input type="checkbox" value="sight" checked/>Sights & gardens</label><label><input type="checkbox" value="mimo" checked/>From Mimo</label></div>
      <button class="search-area glass" id="search-area">Search this area</button>
      <aside class="map-sheet glass" id="map-sheet" data-size="small" aria-label="Places panel"><button class="sheet-handle" id="sheet-handle" aria-label="Expand places panel" aria-expanded="false"><span></span></button><div class="map-sheet-heading"><div><strong id="map-heading">Explore Shinjuku</strong><p id="map-subtitle">Tokyo · live map</p></div><button class="round-control" id="map-home" aria-label="Reset to Tokyo">↺</button></div><p class="map-feedback" id="map-feedback" role="status">Loading places from OpenStreetMap…</p><div class="map-list" id="map-list"></div></aside>
    </section>
    <section class="app-pane app-scroll situation-wash" id="app-nearby" role="tabpanel" aria-labelledby="tab-nearby" hidden>
      <div class="app-nav-title">Nearby</div><div class="native-content"><div class="preview-banner"><span>Previewing · <span id="preview-time-label">3:00 PM</span></span><button data-app-tab="map">Back to map</button></div><h3 id="nearby-place">Menya Kaze</h3><p class="native-subtitle" id="nearby-context">Tokyo · sample place card</p><label class="time-picker">Look ahead <select id="preview-time"><option value="9">9 AM</option><option value="15" selected>3 PM</option><option value="19">7 PM</option><option value="22">10 PM</option></select></label><div class="native-card"><span class="native-caption">What to say · example phrase</span><p class="native-phrase" lang="ja" id="native-phrase">一番人気はどれですか？</p><p class="native-romanization" id="native-romanization">Ichiban ninki wa dore desu ka?</p><p id="native-gloss">Which one is the most popular?</p><p class="native-because">Because you’d like to try a local favourite.</p><button class="native-primary" data-show-phrase>Show</button></div><div class="native-tip"><span aria-hidden="true">ⓘ</span><p id="native-tip">At a ticket-machine ramen shop, buy your ticket first and hand it to the staff.</p></div><div class="native-quick"><button id="taxi-card">Taxi card</button><button data-app-tab="mimo">Ask Mimo</button></div><button class="native-map-link" data-app-tab="map"><span>See this place on the map</span><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.map}/></button><p class="native-disclaimer">Example language card. Live places are shown on Map; phrases here are a product demonstration.</p></div>
    </section>
    <section class="app-pane translate-pane situation-wash" id="app-translate" role="tabpanel" aria-labelledby="tab-translate" hidden><div class="app-nav-title">Translate <button id="face-to-face" aria-pressed="false">Face to face</button></div><div class="translation-halves" id="translation-halves"><div class="translation-half"><span id="their-language">中文</span><p lang="zh-Hans" id="their-words">需要袋子吗？</p></div><div class="translation-half"><span>English</span><p id="your-words">Would you like a bag?</p></div></div><div class="translate-bottom"><p id="translate-status" role="status">Sample conversation</p><div class="language-controls"><span>English</span><button id="play-conversation" aria-label="Play sample conversation"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="2" width="6" height="13" rx="3"/><path d="M5 10v2a7 7 0 0 0 14 0v-2M12 19v3M8 22h8"/></svg></button><span>中文</span></div><p class="native-disclaimer">Tap to play the sample. Live speech runs in the iPhone app.</p></div></section>
    <section class="app-pane mimo-pane situation-wash" id="app-mimo" role="tabpanel" aria-labelledby="tab-mimo" hidden><header class="native-mimo-header"><img src="/assets/mimo.svg" width="82" height="82" alt="Mimo"/><strong>Mimo</strong><span>Your local friend</span></header><div class="native-chat" id="native-chat"><p>Ask me what to order, how to say it, or where to go next.</p><div class="chat-starters"><button data-mimo="order">How do I ask for less ice?</button><button data-mimo="places">Show me places nearby</button></div><div id="mimo-reply" aria-live="polite"></div></div><p class="native-disclaimer chat-disclaimer">Sample replies · place pins use live map data</p></section>
    <section class="app-pane app-scroll situation-wash" id="app-me" role="tabpanel" aria-labelledby="tab-me" hidden><div class="app-nav-title">Me</div><div class="native-content"><h3>A little about you.</h3><p class="native-subtitle">Sample profile · changes stay in this preview</p><div class="native-card settings-card"><label>Home language <select><option>English</option></select></label><label>Less sweet <input id="less-sweet" type="checkbox" checked/></label><label>Romanization <input id="romanization" type="checkbox" checked/></label><label>Travel style <select><option>Quiet corners</option><option>Lively streets</option></select></label></div><p class="native-disclaimer">In the app, your preferences shape your suggestions and the “because…” line.</p><button class="native-primary" data-app-tab="nearby">See your phrase card</button></div></section>
    <div class="app-tabbar glass" role="tablist" aria-label="Ryoko app tabs">
      {['translate','nearby','map','mimo','me'].map((name)=><button id={`tab-${name}`} role="tab" aria-controls={`app-${name}`} aria-selected={name==='map'?'true':'false'} tabindex={name==='map'?0:-1} data-app-tab={name}>{name==='mimo'?<img src="/assets/mimo.svg" width="23" height="23" alt=""/>:<svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[name]}/>}<span>{name[0].toUpperCase()+name.slice(1)}</span></button>)}
    </div><div class="app-home-indicator" aria-hidden="true"></div>
    <div class="app-show" id="app-show" role="dialog" aria-modal="true" aria-label="Show phrase" hidden><button id="done-show">Done</button><div id="show-words"><p lang="zh-Hans" id="show-local">少糖，去冰</p><span id="show-gloss">Less sugar, no ice.</span></div><button id="flip-show" aria-pressed="false">Flip</button></div>
  </div>
  <div class="app-caption"><span><i></i> Live map · interactive web preview</span><button id="expand-app">Expand preview</button></div>
  <p class="app-map-note">Pan, zoom, search, or try the five tabs.</p>
</div>
<script>import '../scripts/app-preview';</script>
